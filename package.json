{
  "name": "little-legends-puzzle-pvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Original Match-3 Puzzle PVP game inspired by Little Legends: Puzzle PVP, built with React, TypeScript, Vite, and Capacitor iOS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node server/pvp-server.ts",
    "test": "node --test tests/engine.test.ts",
    "ios:sync": "npm run build && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@pixi-spine/all-3.8": "^4.0.6",
    "pixi.js-legacy": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
